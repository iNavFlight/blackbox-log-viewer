{
  "name": "inav-blackbox-explorer",
  "productName": "Blackbox Explorer",
  "displayName": "INAV - Blackbox Explorer",
  "description": "Crossplatform blackbox analytics tool for the INAV flight control system.",
  "version": "10.0.0",
  "type": "module",
  "main": "electron/main.js",
  "default_locale": "en",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build --mode desktop && electron .",
    "desktop:package": "vite build --mode desktop && electron-forge package",
    "desktop:make": "vite build --mode desktop && electron-forge make",
    "lint": "eslint src electron forge.config.js",
    "lint:fix": "eslint src electron forge.config.js --fix",
    "format": "prettier --write src"
  },
  "repository": {
    "type": "git",
    "url": "github.com/iNavFlight/blackbox-log-viewer"
  },
  "author": "The INAV open source project",
  "license": "GPL-3.0",
  "dependencies": {
    "html2canvas": "^1.0.0-rc.5",
    "leaflet": "^1.9.3",
    "leaflet-marker-rotation": "^0.4.0",
    "Leaflet.MultiOptionsPolyline": "github:hgoebl/Leaflet.MultiOptionsPolyline",
    "pinia": "^3.0.4",
    "semver": "^7.7.4",
    "sortablejs": "^1.15.7",
    "throttle-debounce": "^5.0.0",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4",
    "webm-writer": "^1.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.105",
    "@nuxt/ui": "^4.8.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^38.8.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
